<?xml version="1.0" encoding="utf-8"?>
<!-- خلفية شاشة create_tender: تدرّج + توهّج + رسمة خاصة -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- تدرّج عمودي -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#251E3C"
                android:centerColor="#101123"
                android:endColor="#070B18" />
        </shape>
    </item>

    <!-- توهّج شفاف -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.0"
                android:centerY="0.3"
                android:gradientRadius="90%p"
                android:startColor="#38C084FC"
                android:endColor="#00C084FC" />
        </shape>
    </item>

    <!-- الرسمة (أسفل اليمين) -->
    <item
        android:drawable="@drawable/art_create_tender"
        android:width="360dp"
        android:height="360dp"
        android:gravity="bottom|end" />
</layer-list>
