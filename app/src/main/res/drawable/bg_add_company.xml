<?xml version="1.0" encoding="utf-8"?>
<!-- خلفية شاشة add_company: تدرّج + توهّج + رسمة خاصة -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- تدرّج عمودي -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#0E2B2D"
                android:centerColor="#09151E"
                android:endColor="#070B18" />
        </shape>
    </item>

    <!-- توهّج شفاف -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.0"
                android:centerY="0.2"
                android:gradientRadius="90%p"
                android:startColor="#3834D399"
                android:endColor="#0034D399" />
        </shape>
    </item>

    <!-- الرسمة (أسفل اليمين) -->
    <item
        android:drawable="@drawable/art_add_company"
        android:width="360dp"
        android:height="360dp"
        android:gravity="bottom|end" />
</layer-list>
