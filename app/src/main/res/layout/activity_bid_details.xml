<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_bid_details">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:layoutDirection="rtl">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تفاصيل العرض"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:id="@+id/tvBidCompany"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="الشركة: شركة المستقبل"
            android:textColor="#CBD5E1"
            android:textSize="16sp"
            android:background="#111827"
            android:padding="16dp"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/tvBidTender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="المناقصة: توريد أجهزة حاسوب"
            android:textColor="#CBD5E1"
            android:textSize="16sp"
            android:background="#111827"
            android:padding="16dp"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/tvBidAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="قيمة العرض: 45,000 دولار"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:background="#18213A"
            android:padding="18dp"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/tvBidDuration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="مدة التنفيذ: 30 يوم"
            android:textColor="#CBD5E1"
            android:textSize="16sp"
            android:background="#111827"
            android:padding="16dp"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/tvBidNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ملاحظات العرض..."
            android:textColor="#CBD5E1"
            android:textSize="15sp"
            android:background="#111827"
            android:padding="18dp"
            android:layout_marginBottom="20dp"/>

        <Button
            android:id="@+id/btnEvaluateBid"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="تقييم العرض"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#7C3AED"/>

    </LinearLayout>

</ScrollView>