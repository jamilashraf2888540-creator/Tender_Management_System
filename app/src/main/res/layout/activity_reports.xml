<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_reports">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp"
        android:layoutDirection="rtl">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="التقارير والإحصائيات"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:id="@+id/tvReportTenders"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:text="إجمالي المناقصات&#10;18"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold"
            android:background="#18213A"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/tvReportCompanies"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:text="إجمالي الشركات&#10;35"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold"
            android:background="#111827"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/tvReportBids"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:text="إجمالي العروض&#10;72"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold"
            android:background="#18213A"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/tvReportContracts"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:text="إجمالي العقود&#10;12"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold"
            android:background="#111827"
            android:layout_marginBottom="20dp"/>

        <Button
                android:id="@+id/btnGenerateReport"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="إنشاء تقرير"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#7C3AED"/>

    </LinearLayout>

</ScrollView>