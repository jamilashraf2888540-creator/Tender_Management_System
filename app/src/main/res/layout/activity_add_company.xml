<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_add_company"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:layoutDirection="rtl">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="إضافة شركة جديدة"
            android:textColor="#FFFFFF"
            android:textSize="25sp"
            android:textStyle="bold"
            android:layout_marginBottom="22dp"/>

        <EditText
            android:id="@+id/etCompanyName"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:hint="اسم الشركة"
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B"
            android:padding="16dp"
            android:background="#111827"
            android:inputType="text"
            android:layout_marginBottom="14dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="حالة الشركة"
            android:textColor="#CBD5E1"
            android:textSize="14sp"
            android:layout_marginBottom="6dp"/>

        <Spinner
            android:id="@+id/spCompanyStatus"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="#111827"
            android:layout_marginBottom="14dp"/>

        <EditText
            android:id="@+id/etCompanyRegistration"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:hint="رقم التسجيل"
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B"
            android:padding="16dp"
            android:background="#111827"
            android:inputType="text"
            android:layout_marginBottom="14dp"/>

        <EditText
            android:id="@+id/etCompanyPhone"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:hint="رقم الهاتف"
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B"
            android:padding="16dp"
            android:background="#111827"
            android:inputType="phone"
            android:layout_marginBottom="14dp"/>

        <EditText
            android:id="@+id/etCompanyEmail"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:hint="البريد الإلكتروني"
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B"
            android:padding="16dp"
            android:background="#111827"
            android:inputType="textEmailAddress"
            android:layout_marginBottom="20dp"/>

        <Button
            android:id="@+id/btnSaveCompany"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="حفظ الشركة"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#7C3AED"/>

    </LinearLayout>

</ScrollView>