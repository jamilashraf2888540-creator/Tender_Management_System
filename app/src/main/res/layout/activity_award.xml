<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_award">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:layoutDirection="rtl">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ترسية المناقصة"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"/>

        <Spinner
            android:id="@+id/spAwardTender"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="#111827"
            android:layout_marginBottom="15dp"/>

        <TextView
            android:id="@+id/tvWinningCompany"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="الشركة الفائزة: شركة المستقبل"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="#18213A"
            android:padding="18dp"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/tvWinningAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="قيمة العقد: 45,000 دولار"
            android:textColor="#34D399"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="#12352F"
            android:padding="18dp"
            android:layout_marginBottom="20dp"/>

        <EditText
            android:id="@+id/etAwardNotes"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:hint="ملاحظات الترسية"
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B"
            android:padding="16dp"
            android:gravity="top"
            android:background="#111827"
            android:inputType="textMultiLine"
            android:layout_marginBottom="20dp"/>

        <Button
            android:id="@+id/btnAwardTender"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="تأكيد ترسية المناقصة"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#10B981"/>

    </LinearLayout>

</ScrollView>